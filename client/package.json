{
  "name": "bomberman-arena-client",
  "version": "1.0.0",
  "description": "Bomberman Arena - Client Electron + PixiJS",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --passWithNoTests --coverage --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=./coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "electron": "^44.3.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@44.3.0": true
  },
  "dependencies": {
    "pixi.js": "^8.20.1",
    "socket.io-client": "^4.8.1"
  }
}
